import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Btn, Icon, Graph, Series } from "widgets.slint";

export struct DockerKV {
    label: string,
    value: string,
}

export struct DockerRow {
    /// 0 = server header, 1 = container, 2 = expanded detail.
    kind: int,
    server: int,
    id: string,
    name: string,
    image: string,
    state: string,
    state-color: color,
    /// Docker's status line, shown as the Age column ("Up 2 hours").
    status: string,
    ports: string,
    running: bool,
    /// Container: the row is expanded (its detail panel shows). Server header:
    /// the server's containers are shown.
    expanded: bool,
    // Server header (kind 0):
    server-status: string,
    server-error: bool,
    // Expanded detail (kind 2) — also carries the CPU/RAM cells of kind 1:
    cpu-series: Series,
    cpu-text: string,
    mem-series: Series,
    mem-text: string,
    facts: [DockerKV],
}

/// One table column: `key` is the canonical sort id (settings' docker_sort),
/// `r` the distance from the table's right edge to the column's left side.
export struct DockerHead {
    key: int,
    label: string,
    r: length,
    w: length,
    /// The first column stretches over the leftover width.
    flex: bool,
}

export global DockerPage {
    in property <[DockerRow]> rows;
    in property <[DockerHead]> heads;
    in property <string> summary;
    in property <bool> configured;
    in property <int> sort;
    in property <bool> sort-desc;
    /// Container action: "start" | "stop" | "restart".
    callback action(string, string);
    /// Server op: "refresh" | "remove", with the server index.
    callback server-op(int, string);
    /// Show or hide a server's containers (click its header).
    callback toggle-server(int);
    /// Rename a server (right-click its header → Rename, then Enter).
    callback rename-server(int, string);
    /// Add a server (the form at the bottom of the tab).
    callback add-server(string, string);
    /// Sort by the column with this canonical id.
    callback sort-by(int);
    /// Column `key` dropped at `x` of a header `width` wide.
    callback column-dropped(int, length, length);
    callback columns-reset();
    /// Expand or collapse a container by id.
    callback toggle(string);
}

component StateDot inherits Rectangle {
    in property <color> tint;
    width: 9px;
    height: 9px;
    border-radius: 4.5px * Theme.round;
    background: root.tint;
}

component ActionBtn inherits Rectangle {
    in property <string> icon;
    in property <color> tint;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 7px * Theme.round;
    background: ta.has-hover ? root.tint.with-alpha(0.18) : transparent;
    Icon {
        width: 15px;
        height: 15px;
        icon: root.icon;
        color: ta.has-hover ? root.tint : Theme.dim;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// A sortable, drag-to-reorder table header cell (same mechanics as the
/// Processes tab: click sorts, dragging past 6px moves the column).
component HeadCell inherits Rectangle {
    in property <int> key;
    in property <string> label;
    in property <bool> active;
    in property <bool> desc;
    in property <bool> flex;
    in property <length> r;
    in property <length> w;
    callback clicked;
    /// Dropped after dragging; the argument is the drop x in the header.
    callback dropped(length);
    property <length> press-x;
    property <length> drag-dx;
    property <bool> pressing;
    property <bool> dragging;
    background: root.dragging ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    z: root.dragging ? 2 : 0;
    VerticalLayout {
        x: root.dragging ? root.drag-dx : 0;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label + (root.active ? (root.desc ? " ↓" : " ↑") : "");
            font-size: 11.5px * Theme.font-scale;
            font-weight: 600;
            color: root.active ? Theme.accent : Theme.dim;
            // Numbers sit right in their column; everything else lines up with
            // the left edge of its cells.
            horizontal-alignment: (root.key == 4 || root.key == 5) ? right : left;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.press-x = self.mouse-x;
                root.pressing = true;
            }
            if (event.kind == PointerEventKind.up && root.pressing) {
                root.pressing = false;
                if (root.dragging) {
                    root.dragging = false;
                    root.dropped(root.x + self.mouse-x);
                } else {
                    root.clicked();
                }
                root.drag-dx = 0;
            }
        }
        moved => {
            root.drag-dx = self.mouse-x - root.press-x;
            if (abs(root.drag-dx) > 6px) {
                root.dragging = true;
            }
        }
    }
}

component ServerHeader inherits Rectangle {
    in property <DockerRow> item;
    callback op(string);
    callback toggle();
    /// Rename was committed with a new name (Enter in the inline field).
    callback rename(string);
    property <bool> renaming: false;
    height: 40px;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggle();
        }
    }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: root.item.expanded ? "Hide containers" : "Show containers";
                activated => {
                    root.toggle();
                }
            }
            MenuItem {
                title: "Rename";
                activated => {
                    root.renaming = true;
                }
            }
            MenuItem {
                title: "Refresh";
                activated => {
                    root.op("refresh");
                }
            }
            MenuItem {
                title: "Remove server";
                activated => {
                    root.op("remove");
                }
            }
        }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            Rectangle {
                width: 14px;
                Icon {
                    width: 13px;
                    height: 13px;
                    icon: root.item.expanded ? "M 6 9 L 12 15 L 18 9" : "M 9 6 L 15 12 L 9 18";
                    color: Theme.dim;
                }
            }
            VerticalLayout {
                alignment: center;
                StateDot {
                    tint: root.item.server-error ? Theme.danger : Theme.gpu;
                }
            }
            if root.renaming: rename-scope := FocusScope {
                width: 180px;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.renaming = false;
                        return accept;
                    }
                    reject
                }
                name-in := TextInput {
                    width: parent.width;
                    height: parent.height;
                    vertical-alignment: center;
                    single-line: true;
                    color: Theme.text;
                    font-size: 13px * Theme.font-scale;
                    init => {
                        name-in.text = root.item.name;
                        name-in.focus();
                        name-in.select-all();
                    }
                    accepted => {
                        root.rename(name-in.text);
                        root.renaming = false;
                    }
                }
            }
            if !root.renaming: Text {
                text: root.item.name;
                font-size: 13px * Theme.font-scale;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                text: root.item.server-status;
                font-size: 11.5px * Theme.font-scale;
                color: root.item.server-error ? Theme.danger : Theme.dim;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            ActionBtn {
                icon: "M 20 11 A 8 8 0 1 0 19 15 M 20 5 L 20 11 L 14 11";
                tint: Theme.accent;
                clicked => {
                    root.op("refresh");
                }
            }
            ActionBtn {
                icon: "M 6 6 L 18 18 M 18 6 L 6 18";
                tint: Theme.danger;
                clicked => {
                    root.op("remove");
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

/// One aligned cell of a container row. `head` decides position; `item` the
/// content (switched by the canonical column id).
component Cell inherits Rectangle {
    in property <DockerHead> head;
    in property <DockerRow> item;
    if root.head.key == 1: HorizontalLayout {
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            width: 14px;
            alignment: center;
            Icon {
                width: 13px;
                height: 13px;
                icon: root.item.expanded ? "M 6 9 L 12 15 L 18 9" : "M 9 6 L 15 12 L 9 18";
                color: Theme.dim;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.name;
                    font-size: 13px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
            }
            Text {
                text: root.item.image;
                font-size: 10.5px * Theme.font-scale;
                color: Theme.faint;
                overflow: elide;
            }
        }
    }
    if root.head.key == 2: HorizontalLayout {
        alignment: start;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            StateDot {
                tint: root.item.state-color;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.state;
                font-size: 12px * Theme.font-scale;
                color: root.item.state-color;
            }
        }
    }
    if root.head.key == 0: VerticalLayout {
        alignment: center;
        padding-right: 10px;
        Text {
            text: root.item.ports;
            font-size: 11.5px * Theme.font-scale;
            color: Theme.dim;
            overflow: elide;
        }
    }
    if root.head.key == 3: VerticalLayout {
        alignment: center;
        padding-right: 10px;
        Text {
            text: root.item.status;
            font-size: 11.5px * Theme.font-scale;
            color: Theme.dim;
            overflow: elide;
        }
    }
    if root.head.key == 4: VerticalLayout {
        alignment: center;
        Text {
            text: root.item.cpu-text;
            font-size: 12px * Theme.font-scale;
            color: root.item.cpu-text == "—" ? Theme.faint : Theme.text;
            horizontal-alignment: right;
        }
    }
    if root.head.key == 5: VerticalLayout {
        alignment: center;
        Text {
            text: root.item.mem-text;
            font-size: 12px * Theme.font-scale;
            color: root.item.mem-text == "—" ? Theme.faint : Theme.text;
            horizontal-alignment: right;
        }
    }
}

component ContainerRow inherits Rectangle {
    in property <DockerRow> item;
    callback act(string);
    callback toggle();
    height: 48px;
    background: root.item.expanded ? Theme.surface-2 : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        clicked => {
            root.toggle();
        }
    }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: root.item.running ? "Restart" : "Start";
                activated => {
                    root.act(root.item.running ? "restart" : "start");
                }
            }
            MenuItem {
                title: "Stop";
                activated => {
                    root.act("stop");
                }
            }
        }
        Rectangle {
            for h in DockerPage.heads: Cell {
                head: h;
                item: root.item;
                x: h.flex ? 12px : parent.width - h.r;
                width: h.flex ? parent.width - h.r - 12px : h.w;
                height: parent.height;
            }
        }
    }
}

component MiniGraph inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <Series> series;
    in property <color> tint;
    spacing: 4px;
    HorizontalLayout {
        Text {
            text: root.label;
            font-size: 11px * Theme.font-scale;
            color: Theme.dim;
        }
        Text {
            text: root.value;
            font-size: 11px * Theme.font-scale;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: right;
        }
    }
    Graph {
        height: 70px;
        a: root.series;
        color-a: root.tint;
    }
}

component DetailPanel inherits Rectangle {
    in property <DockerRow> item;
    background: Theme.surface-2;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 36px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 20px;
        VerticalLayout {
            width: 300px;
            spacing: 12px;
            MiniGraph {
                label: "CPU";
                value: root.item.cpu-text;
                series: root.item.cpu-series;
                tint: Theme.cpu;
            }
            MiniGraph {
                label: "Memory";
                value: root.item.mem-text;
                series: root.item.mem-series;
                tint: Theme.mem;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            alignment: start;
            for f in root.item.facts: HorizontalLayout {
                spacing: 12px;
                Text {
                    width: 120px;
                    text: f.label;
                    font-size: 11.5px * Theme.font-scale;
                    color: Theme.dim;
                }
                Text {
                    horizontal-stretch: 1;
                    text: f.value;
                    font-size: 11.5px * Theme.font-scale;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component AddServerForm inherits Rectangle {
    height: 56px;
    border-radius: 10px * Theme.round;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 180px;
            border-radius: 8px * Theme.round;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: name-in.has-focus ? Theme.accent : Theme.border;
            if name-in.text == "": Text {
                x: 10px;
                text: "Name (e.g. NAS)";
                color: Theme.faint;
                font-size: 12.5px * Theme.font-scale;
            }
            name-in := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                font-size: 13px * Theme.font-scale;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px * Theme.round;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: addr-in.has-focus ? Theme.accent : Theme.border;
            if addr-in.text == "": Text {
                x: 10px;
                text: "Address — host:port of the socket proxy (e.g. 10.0.0.5:2375)";
                color: Theme.faint;
                font-size: 12.5px * Theme.font-scale;
            }
            addr-in := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                font-size: 13px * Theme.font-scale;
                accepted => {
                    DockerPage.add-server(name-in.text, addr-in.text);
                    name-in.text = "";
                    addr-in.text = "";
                }
            }
        }
        Btn {
            text: "Add server";
            primary: true;
            clicked => {
                DockerPage.add-server(name-in.text, addr-in.text);
                name-in.text = "";
                addr-in.text = "";
            }
        }
    }
}

export component DockerView inherits Rectangle {
    VerticalLayout {
        // Header.
        VerticalLayout {
            padding-left: 18px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 8px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Docker";
                    font-size: 20px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Text {
                    text: DockerPage.summary;
                    font-size: 12px * Theme.font-scale;
                    color: Theme.dim;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
        ScrollView {
            VerticalLayout {
                padding: 14px;
                padding-top: 4px;
                spacing: 8px;
                alignment: start;
                if !DockerPage.configured: Rectangle {
                    height: 120px;
                    border-radius: 10px * Theme.round;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "Connect to a server running Docker";
                            font-size: 15px * Theme.font-scale;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Point Sophon at a docker-socket-proxy on your LAN. It lists containers live and can start, stop and restart them.";
                            width: 520px;
                            wrap: word-wrap;
                            font-size: 12.5px * Theme.font-scale;
                            color: Theme.dim;
                            horizontal-alignment: center;
                        }
                    }
                }
                if DockerPage.configured: header := Rectangle {
                    height: 30px;
                    border-radius: 7px * Theme.round;
                    background: Theme.surface-2;
                    ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "Reset column order";
                                activated => {
                                    DockerPage.columns-reset();
                                }
                            }
                        }
                        Rectangle {
                            for h in DockerPage.heads: HeadCell {
                                key: h.key;
                                label: h.label;
                                active: DockerPage.sort == h.key;
                                desc: DockerPage.sort-desc;
                                flex: h.flex;
                                r: h.r;
                                w: h.w;
                                x: h.flex ? 12px : parent.width - h.r;
                                width: h.flex ? parent.width - h.r - 12px : h.w;
                                height: parent.height;
                                clicked => {
                                    DockerPage.sort-by(h.key);
                                }
                                dropped(x) => {
                                    DockerPage.column-dropped(h.key, x, header.width);
                                }
                            }
                        }
                    }
                }
                for row[i] in DockerPage.rows: Rectangle {
                    height: row.kind == 0 ? 40px : row.kind == 1 ? 48px : detail.preferred-height;
                    if row.kind == 0: ServerHeader {
                        item: row;
                        op(o) => {
                            DockerPage.server-op(row.server, o);
                        }
                        toggle => {
                            DockerPage.toggle-server(row.server);
                        }
                        rename(n) => {
                            DockerPage.rename-server(row.server, n);
                        }
                    }
                    if row.kind == 1: ContainerRow {
                        item: row;
                        act(a) => {
                            DockerPage.action(row.id, a);
                        }
                        toggle => {
                            DockerPage.toggle(row.id);
                        }
                    }
                    detail := DetailPanel {
                        visible: row.kind == 2;
                        item: row;
                    }
                }
                AddServerForm { }
            }
        }
    }
}
