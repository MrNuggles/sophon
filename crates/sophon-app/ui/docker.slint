import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Btn, Icon, Series, Graph } from "widgets.slint";

export struct DockerKV {
    label: string,
    value: string,
}

export struct DockerRow {
    /// 0 = server header, 1 = container, 2 = expanded detail.
    kind: int,
    server: int,
    id: string,
    name: string,
    image: string,
    state: string,
    state-color: color,
    status: string,
    ports: string,
    running: bool,
    expanded: bool,
    // Server header (kind 0):
    server-status: string,
    server-error: bool,
    // Expanded detail (kind 2):
    cpu-series: Series,
    cpu-text: string,
    mem-series: Series,
    mem-text: string,
    facts: [DockerKV],
}

export global DockerPage {
    in property <[DockerRow]> rows;
    in property <string> summary;
    in property <bool> configured;
    in property <int> sort;
    in property <bool> sort-desc;
    /// Container action: "start" | "stop" | "restart".
    callback action(string, string);
    /// Server op: "refresh" | "remove", with the server index.
    callback server-op(int, string);
    callback add-server(string, string);
    /// Expand or collapse a container by id.
    callback toggle(string);
    callback set-sort(int);
}

component StateDot inherits Rectangle {
    in property <color> tint;
    width: 9px;
    height: 9px;
    border-radius: 4.5px * Theme.round;
    background: root.tint;
}

component ActionBtn inherits Rectangle {
    in property <string> icon;
    in property <color> tint;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 7px * Theme.round;
    background: ta.has-hover ? root.tint.with-alpha(0.18) : transparent;
    Icon {
        width: 15px;
        height: 15px;
        icon: root.icon;
        color: ta.has-hover ? root.tint : Theme.dim;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component SortChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> desc;
    callback clicked;
    height: 28px;
    min-width: label.preferred-width + 26px;
    border-radius: 14px * Theme.round;
    background: root.active ? Theme.accent.with-alpha(0.16) : ta.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.accent.with-alpha(0.55) : Theme.border;
    label := Text {
        x: 12px;
        text: root.text + (root.active ? (root.desc ? "  ↓" : "  ↑") : "");
        font-size: 12px * Theme.font-scale;
        color: root.active ? Theme.accent : Theme.dim;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ContainerRow inherits Rectangle {
    in property <DockerRow> item;
    callback act(string);
    callback toggle();
    height: 52px;
    background: root.item.expanded ? Theme.surface-2 : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        clicked => {
            root.toggle();
        }
    }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: root.item.running ? "Restart" : "Start";
                activated => {
                    root.act(root.item.running ? "restart" : "start");
                }
            }
            MenuItem {
                title: "Stop";
                activated => {
                    root.act("stop");
                }
            }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 10px;
            Rectangle {
                width: 14px;
                Icon {
                    width: 13px;
                    height: 13px;
                    icon: root.item.expanded ? "M 6 9 L 12 15 L 18 9" : "M 9 6 L 15 12 L 9 18";
                    color: Theme.dim;
                }
            }
            VerticalLayout {
                alignment: center;
                StateDot {
                    tint: root.item.state-color;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.item.name;
                        font-size: 13.5px * Theme.font-scale;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: root.item.state;
                        font-size: 11px * Theme.font-scale;
                        color: root.item.state-color;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.item.image + (root.item.ports != "" ? "     " + root.item.ports : "");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.dim;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.item.status;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.faint;
                    horizontal-alignment: right;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 2px;
                    if !root.item.running: ActionBtn {
                        icon: "M 7 5 L 19 12 L 7 19 Z";
                        tint: Theme.gpu;
                        clicked => {
                            root.act("start");
                        }
                    }
                    if root.item.running: ActionBtn {
                        icon: "M 5 5 L 12 12 M 12 12 L 5 19 M 19 5 A 10 10 0 0 1 19 19";
                        tint: Theme.cpu;
                        clicked => {
                            root.act("restart");
                        }
                    }
                    if root.item.running: ActionBtn {
                        icon: "M 7 7 L 17 7 L 17 17 L 7 17 Z";
                        tint: Theme.danger;
                        clicked => {
                            root.act("stop");
                        }
                    }
                }
            }
        }
    }
}

component MiniGraph inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <Series> series;
    in property <color> tint;
    spacing: 4px;
    HorizontalLayout {
        Text {
            text: root.label;
            font-size: 11px * Theme.font-scale;
            color: Theme.dim;
        }
        Text {
            text: root.value;
            font-size: 11px * Theme.font-scale;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: right;
        }
    }
    Graph {
        height: 70px;
        a: root.series;
        color-a: root.tint;
    }
}

component DetailPanel inherits Rectangle {
    in property <DockerRow> item;
    background: Theme.surface-2;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 36px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 20px;
        VerticalLayout {
            width: 300px;
            spacing: 12px;
            MiniGraph {
                label: "CPU";
                value: root.item.cpu-text;
                series: root.item.cpu-series;
                tint: Theme.cpu;
            }
            MiniGraph {
                label: "Memory";
                value: root.item.mem-text;
                series: root.item.mem-series;
                tint: Theme.mem;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            alignment: start;
            for f in root.item.facts: HorizontalLayout {
                spacing: 12px;
                Text {
                    width: 120px;
                    text: f.label;
                    font-size: 11.5px * Theme.font-scale;
                    color: Theme.dim;
                }
                Text {
                    horizontal-stretch: 1;
                    text: f.value;
                    font-size: 11.5px * Theme.font-scale;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component ServerHeader inherits Rectangle {
    in property <DockerRow> item;
    callback op(string);
    height: 40px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            StateDot {
                tint: root.item.server-error ? Theme.danger : Theme.gpu;
            }
        }
        Text {
            text: root.item.name;
            font-size: 13px * Theme.font-scale;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.item.server-status;
            font-size: 11.5px * Theme.font-scale;
            color: root.item.server-error ? Theme.danger : Theme.dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        ActionBtn {
            icon: "M 20 11 A 8 8 0 1 0 19 15 M 20 5 L 20 11 L 14 11";
            tint: Theme.accent;
            clicked => {
                root.op("refresh");
            }
        }
        ActionBtn {
            icon: "M 6 6 L 18 18 M 18 6 L 6 18";
            tint: Theme.danger;
            clicked => {
                root.op("remove");
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

component AddServerForm inherits Rectangle {
    height: 56px;
    border-radius: 10px * Theme.round;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 180px;
            border-radius: 8px * Theme.round;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: name-in.has-focus ? Theme.accent : Theme.border;
            if name-in.text == "": Text {
                x: 10px;
                text: "Name (e.g. NAS)";
                color: Theme.faint;
                font-size: 12.5px * Theme.font-scale;
            }
            name-in := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                font-size: 13px * Theme.font-scale;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px * Theme.round;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: addr-in.has-focus ? Theme.accent : Theme.border;
            if addr-in.text == "": Text {
                x: 10px;
                text: "Address — host:port of the socket proxy (e.g. 10.0.0.5:2375)";
                color: Theme.faint;
                font-size: 12.5px * Theme.font-scale;
            }
            addr-in := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                font-size: 13px * Theme.font-scale;
                accepted => {
                    DockerPage.add-server(name-in.text, addr-in.text);
                    name-in.text = "";
                    addr-in.text = "";
                }
            }
        }
        Btn {
            text: "Add server";
            primary: true;
            clicked => {
                DockerPage.add-server(name-in.text, addr-in.text);
                name-in.text = "";
                addr-in.text = "";
            }
        }
    }
}

export component DockerView inherits Rectangle {
    property <[string]> sort-keys: ["Ports", "Name", "State", "Age", "CPU", "RAM"];
    VerticalLayout {
        // Header + sort bar.
        VerticalLayout {
            padding-left: 18px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 8px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Docker";
                    font-size: 20px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Text {
                    text: DockerPage.summary;
                    font-size: 12px * Theme.font-scale;
                    color: Theme.dim;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if DockerPage.configured: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: "Sort";
                    font-size: 12px * Theme.font-scale;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                for key[i] in root.sort-keys: SortChip {
                    text: key;
                    active: DockerPage.sort == i;
                    desc: DockerPage.sort-desc;
                    clicked => {
                        DockerPage.set-sort(i);
                    }
                }
            }
        }
        ScrollView {
            VerticalLayout {
                padding: 14px;
                padding-top: 4px;
                spacing: 8px;
                alignment: start;
                if !DockerPage.configured: Rectangle {
                    height: 120px;
                    border-radius: 10px * Theme.round;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "Connect to a server running Docker";
                            font-size: 15px * Theme.font-scale;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Point Sophon at a docker-socket-proxy on your LAN. It lists containers live and can start, stop and restart them.";
                            width: 520px;
                            wrap: word-wrap;
                            font-size: 12.5px * Theme.font-scale;
                            color: Theme.dim;
                            horizontal-alignment: center;
                        }
                    }
                }
                for row[i] in DockerPage.rows: Rectangle {
                    height: row.kind == 0 ? 40px : row.kind == 1 ? 52px : detail.preferred-height;
                    if row.kind == 0: ServerHeader {
                        item: row;
                        op(o) => {
                            DockerPage.server-op(row.server, o);
                        }
                    }
                    if row.kind == 1: ContainerRow {
                        item: row;
                        act(a) => {
                            DockerPage.action(row.id, a);
                        }
                        toggle => {
                            DockerPage.toggle(row.id);
                        }
                    }
                    detail := DetailPanel {
                        visible: row.kind == 2;
                        item: row;
                    }
                }
                AddServerForm { }
            }
        }
    }
}
